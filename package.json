{
  "name": "wdesign-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "WDesign — 组件库 + 图标库 + 演示站",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @w-run/wdesign-demo dev",
    "build": "pnpm --filter @w-run/wdesign-ui build && pnpm --filter @w-run/wdesign-demo build",
    "build:ui": "pnpm --filter @w-run/wdesign-ui build",
    "build:demo": "pnpm --filter @w-run/wdesign-demo build",
    "check": "pnpm --filter @w-run/wdesign-ui verify",
    "publish:ui": "pnpm --filter @w-run/wdesign-ui publish",
    "publish:icons": "pnpm --filter @w-run/wdesign-icons publish"
  },
  "devDependencies": {
    "vue": "^3.5.0"
  },
  "packageManager": "pnpm@9.0.0"
}
