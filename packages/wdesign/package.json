{
  "name": "@w-run/wdesign",
  "version": "1.0.0",
  "description": "WDesign — Soft Bento · Red；SCSS + Vue3 组件库（无边框 · 色块分区 · 全圆角 · 留白极简；字体走 CDN: https://box.w-run.net/npm/fonts/）",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./full": "./src/full.ts",
    "./components/*": "./src/components/*",
    "./styles": "./src/styles/index.scss",
    "./styles/*": "./src/styles/*",
    "./tokens.json": "./tokens.json",
    "./hover": "./src/hover.ts"
  },
  "files": [
    "src",
    "tokens.json"
  ],
  "scripts": {
    "audit": "python3 tools/design-audit.py",
    "audit:strict": "python3 tools/design-audit.py --strict",
    "gen:index": "node tools/gen-index.mjs",
    "hover:check": "python3 tools/hover-js.py --check"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.css"
  ],
  "keywords": [
    "vue3",
    "vue",
    "scss",
    "design-system",
    "component-library",
    "soft-bento"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@w-run/wdesign-icons": "^1.0.0"
  }
}