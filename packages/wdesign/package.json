{
  "name": "@w-run/wdesign",
  "version": "1.0.0",
  "description": "WDesign UI — Less frame. More space. Vue 3 组件库（无边框 · 色块分区 · 全圆角 · 留白极简）",
  "type": "module",
  "main": "./dist/wdesign.cjs",
  "module": "./dist/wdesign.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wdesign.esm.js",
      "require": "./dist/wdesign.cjs"
    },
    "./style": "./dist/wdesign.css",
    "./style/*": "./dist/style/*.css",
    "./src/*": "./src/*",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "tokens.json",
    "README.md"
  ],
  "scripts": {
    "audit": "python3 tools/design-audit.py",
    "audit:strict": "python3 tools/design-audit.py --strict",
    "gen:index": "node tools/gen-index.mjs",
    "hover:check": "python3 tools/hover-js.py --check",
    "check:tokens": "python3 tools/check-tokens.py --strict",
    "check:icons": "python3 tools/check-icons.py --strict",
    "build": "node tools/build-lib.mjs && node tools/fingerprint.mjs lib",
    "build:demo": "node tools/build-demo.mjs",
    "prepublishOnly": "npm run build",
    "dev": "node tools/wd-dev.mjs",
    "check:fingerprint": "node tools/fingerprint.mjs check",
    "test": "node tools/smoke-test.mjs",
    "test:all": "npm run check:tokens && npm run check:icons && npm run check:fingerprint && npm run typecheck && npm run test",
    "append:icon-style": "node tools/append-icon-style.mjs",
    "typecheck": "node tools/typecheck.mjs"
  },
  "sideEffects": [
    "*.css",
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "vue3",
    "vue",
    "scss",
    "design-system",
    "component-library",
    "wdesign-ui"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@w-run/wdesign-icons": "^1.0.0"
  }
}