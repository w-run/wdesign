{
  "name": "@w-run/wdesign",
  "version": "1.0.0",
  "description": "WDesign — Soft Bento · Red；SCSS + Vue3 组件库（无边框 · 色块分区 · 全圆角 · 留白极简；字体走 CDN: https://box.w-run.net/npm/fonts/）",
  "type": "module",
  "main": "./dist/wdesign.cjs",
  "module": "./dist/wdesign.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/wdesign.esm.js",
      "require": "./dist/wdesign.cjs"
    },
    "./style": "./dist/wdesign.css",
    "./style/*": "./dist/style/*.css",
    "./src/*": "./src/*",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "tokens.json",
    "README.md"
  ],
  "scripts": {
    "audit": "python3 tools/design-audit.py",
    "audit:strict": "python3 tools/design-audit.py --strict",
    "gen:index": "node tools/gen-index.mjs",
    "hover:check": "python3 tools/hover-js.py --check",
    "check:tokens": "python3 tools/check-tokens.py --strict",
    "check:icons": "python3 tools/check-icons.py --strict",
    "build": "node tools/build-lib.mjs",
    "build:demo": "node tools/build-demo-components.mjs",
    "prepublishOnly": "npm run build"
  },
  "sideEffects": [
    "*.css",
    "**/*.css",
    "**/*.scss"
  ],
  "keywords": [
    "vue3",
    "vue",
    "scss",
    "design-system",
    "component-library",
    "soft-bento"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "license": "MIT",
  "dependencies": {
    "@w-run/wdesign-icons": "^1.0.0"
  }
}