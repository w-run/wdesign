{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "brand": {
      "red":        { "type": "color", "value": "#D62839", "comment": "主题红 · 主按钮 / 关键数据" },
      "red-hover":  { "type": "color", "value": "#BC2332", "comment": "悬停" },
      "red-active": { "type": "color", "value": "#A21E2B", "comment": "按下" },
      "red-soft":   { "type": "color", "value": "#E05B68", "comment": "深色底上的红" }
    },
    "tint": {
      "tint-1": { "type": "color", "value": "#FDF2F3", "comment": "最浅 / 高亮底" },
      "tint-2": { "type": "color", "value": "#FBEAEB", "comment": "块底 / 次级按钮" },
      "tint-3": { "type": "color", "value": "#F8DDDF", "comment": "轨道 / 选中" },
      "tint-4": { "type": "color", "value": "#F3BEC4", "comment": "强调块" }
    },
    "neutral": {
      "ink":   { "type": "color", "value": "#191B1F", "comment": "正文" },
      "ink-2": { "type": "color", "value": "#8A9099", "comment": "说明" },
      "ink-3": { "type": "color", "value": "#B8BEC7", "comment": "占位" },
      "bg":    { "type": "color", "value": "#F7F8FA", "comment": "页面底 L0" },
      "card":  { "type": "color", "value": "#FFFFFF", "comment": "卡片 L1" },
      "dark":   { "type": "color", "value": "#1C1C1C", "comment": "深色一级 · 锚点 L4" },
      "dark-2": { "type": "color", "value": "#2F2F2F", "comment": "深色二级 · 浮层 / 悬停" }
    },
    "semantic": {
      "success": { "type": "color", "value": "#2FA57C" },
      "warning": { "type": "color", "value": "#E8A33D" },
      "success-soft": { "type": "color", "value": "#E8F6F0", "comment": "成功 · 浅底" },
      "warning-soft": { "type": "color", "value": "#FCF4E8", "comment": "警告 · 浅底" },
      "field": { "type": "color", "value": "#E9EDF1", "comment": "控件底色（白卡 / 灰底通用）" },
      "danger":  { "type": "color", "value": "#D62839", "comment": "复用主题红" }
    }
  },
  "radius": {
    "sm":   { "type": "dimension", "value": "12px", "comment": "小元件" },
    "md":   { "type": "dimension", "value": "16px", "comment": "列表行" },
    "lg":   { "type": "dimension", "value": "24px", "comment": "卡片" },
    "xl":   { "type": "dimension", "value": "32px", "comment": "大容器" },
    "pill": { "type": "dimension", "value": "999px", "comment": "胶囊" }
  },
  "shadow": {
    "default": { "type": "shadow", "value": "0 12px 30px rgba(25,27,31,.06)" },
    "hover":   { "type": "shadow", "value": "0 16px 40px rgba(25,27,31,.09)" }
  },
  "space": {
    "1":  { "type": "dimension", "value": "4px" },
    "2":  { "type": "dimension", "value": "8px" },
    "3":  { "type": "dimension", "value": "12px" },
    "4":  { "type": "dimension", "value": "16px" },
    "6":  { "type": "dimension", "value": "24px", "comment": "卡内边距（主）" },
    "8":  { "type": "dimension", "value": "32px", "comment": "区块间距（主）" },
    "12": { "type": "dimension", "value": "48px" },
    "16": { "type": "dimension", "value": "64px" }
  },
  "font": {
    "family":  { "type": "fontFamily", "value": "\"Mona Sans\", \"Source Han Sans SC\", \"Noto Sans SC\", \"PingFang SC\", -apple-system, Inter, sans-serif", "comment": "拉丁 Mona Sans + 中文思源黑体（都是 VF 可变字体）" },
    "mono":    { "type": "fontFamily", "value": "\"Mona Sans Mono\", ui-monospace, Menlo, Consolas, monospace" },
    "sizeDisplay": { "type": "dimension", "value": "56px" },
    "sizeH1":      { "type": "dimension", "value": "32px" },
    "sizeH2":      { "type": "dimension", "value": "24px" },
    "sizeH3":      { "type": "dimension", "value": "18px" },
    "sizeBody":    { "type": "dimension", "value": "15.5px" },
    "sizeCaption": { "type": "dimension", "value": "13px" }
  }
}
